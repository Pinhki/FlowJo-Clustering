tryCatch({
# Ensure remotes is available
progress$set(detail = "Checking for 'remotes' package...", value = 0.1)
if (!requireNamespace("remotes", quietly = F)) {
install.packages("remotes", repos = "https://cloud.r-project.org")
}
# Loop through packages
packages_to_install <- env_def$packages
for (i in 1:nrow(packages_to_install)) {
pkg <- packages_to_install$package[i]
ver <- packages_to_install$version[i]
# Update progress for the user
progress$set(detail = paste("Installing", pkg, "version", ver,"\n This might take a hours if this is your first time."), value = (i / nrow(packages_to_install)))
if (!requireNamespace(pkg, quietly = TRUE) || packageVersion(pkg) != ver) {
remotes::install_version(pkg, version = ver, upgrade = "never", quiet = F)
}
}
# --- On success, update the shared data reactiveValues ---
# This is now safe because the whole observer is a reactive context.
shared_data$active_environment <- list(name = chosen_env_id, path = lib_path)
log_messages(paste("SUCCESS: R environment '", chosen_env_id, "' is ready."))
shinyjs::show("proceed_to_import_ui")
}, finally = {
.libPaths(original_lib_paths)
})
runApp('GitHub/Single-Cell-RNA-Seq-Pepline/v0.1.1 alpha Build 0113/Content')
