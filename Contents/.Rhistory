recluster_ui <- fluidPage(
h3("Step 3b: Interactive Subsetting and Re-clustering"),
p("Use the tools below to select a specific population of cells for a more focused analysis. You can filter by gene expression, manually select cells on the UMAP, or both."),
hr(),
sidebarLayout(
sidebarPanel(
width = 4,
h4("Visualization Controls"),
div(
id = "umap_controls",
h4("UMAP Visualization"),
wellPanel(
selectInput("color_by_select", "Color UMAP by:",
choices = c("None", "Clusters", "Sample Name",
"Single Gene Expression", "Two-Gene Overlay")), # Add new choice
selectInput("split_by_select", "Split UMAP by:",
choices = c("None", "Sample Name", "Condition", "Batch")),
conditionalPanel(
condition = "input.color_by_select == 'Single Gene Expression' || input.color_by_select == 'Two-Gene Overlay'",
selectizeInput("gene_expr_select_1", "Gene 1 (Green Channel):", choices = NULL),
# This second selector is for the overlay
conditionalPanel(
condition = "input.color_by_select == 'Two-Gene Overlay'",
selectizeInput("gene_expr_select_2", "Gene 2 (Blue Channel):", choices = NULL)
)
),
actionButton("update_viz_btn", "Update Plot", icon = icon("sync-alt")),
hr(),
sliderInput("dot_size", "Dot Size:", min = 0.1, max = 5, value = 0.5, step = 0.1),
sliderInput("dot_alpha", "Dot Transparency (Alpha):", min = 0.1, max = 1, value = 0.8, step = 0.1),
sliderInput("stroke_width", "Dot Outline Width:", min = 0, max = 2, value = 0.0, step = 0.1),
sliderInput("highlight_width", "Highlight Dot Size:", min = 0, max = 2, value = 0.4, step = 0.1),
selectInput("stroke_color", "Dot Outline Color:",
choices = c("black", "white", "grey50"), selected = "black")
)
),
# --- This div contains controls for the SCATTER PLOT (initially hidden) ---
shinyjs::hidden(
div(
id = "scatter_controls",
h4("Scatter Plot Visualization"),
wellPanel(
selectizeInput("scatter_gene_x", "Gene for X-axis:", choices = NULL,
options = list(placeholder = 'e.g., Cd4')),
selectizeInput("scatter_gene_y", "Gene for Y-axis:", choices = NULL,
options = list(placeholder = 'e.g., Cd8a')),
checkboxGroupInput("scatter_log_scale", "Axis Scale:", choices = c("Log Scale X-axis", "Log Scale Y-axis")),
hr(),
selectInput("scatter_color_by", "Color by:",
choices = NULL) # Choices will now be populated by the server
)
)
),
hr(),
h4("Subset Controls"),
wellPanel(
h5("Cell Group Management"),
p("Use the 'Lasso Select' tool, then name and save the selection."),
textInput("new_group_name", "New Group Name:", placeholder = "e.g., T-cells"),
actionButton("add_selection_btn", "Save Selection as Group", icon = icon("plus")),
hr(),
h5("Saved Groups:"),
uiOutput("cell_groups_ui") # A dynamic placeholder for the group list
),
# --- Gene Expression Filtering ---
h5("1. Filter by Gene Expression"),
p("Define rules to select cells based on expression levels."),
# Positive selection
textInput("gene_pos_select", "Positive Selection Gene:", placeholder = "e.g., CD4"),
numericInput("gene_pos_thresh", "Expression >", value = 0, min = 0),
# Negative selection
textInput("gene_neg_select", "Negative Selection Gene:", placeholder = "e.g., CD8A"),
numericInput("gene_neg_thresh", "Expression ==", value = 0, min = 0),
# --- Manual Selection Info ---
h5("2. Filter by Manual Selection"),
p("Use the 'Lasso Select' tool on the UMAP, OR upload a list of cell barcodes below."),
# --- ADD THIS ---
fileInput("import_barcodes_file", "Import Cell Barcodes (.txt/.csv):", accept = c(".txt", ".csv")),
verbatimTextOutput("selected_cell_count_output"),
# --- Final Action Button ---
hr(),
h5("3. Re-cluster Selected Population"),
p("This will take the final subset of cells and send them back to the Analysis page for re-integration and re-clustering."),
verbatimTextOutput("final_cell_count_output"),
actionButton("run_recluster_btn", "Re-cluster Selected Cells", icon = icon("sync-alt"), class = "btn-success")
),
mainPanel(
width = 8,
h4("Interactive UMAP"),
p("Expression of the visualized gene is shown in yellow. All currently selected cells are highlighted in red."),
# --- This tabsetPanel creates the two tabs ---
tabsetPanel(
id = "recluster_tabs", # Give the tabset an ID to track the active tab
tabPanel(
"UMAP Plot",
withSpinner(plotlyOutput("recluster_umap_plot", height = "700px"))
),
tabPanel(
"Gene Scatter Plot",
withSpinner(plotlyOutput("recluster_scatter_plot", height = "700px"))
)
)
)
)
)
runApp('Single-Cell-RNA-Seq-Pepline/v0.2.0 Alpha/Content')
